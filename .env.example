# ── Weaver configuration (copy to .env and edit) ─────────────────────────
# All variables are optional; CLI flags override these values.

# Where the analysis database lives (SQLite file).
WEAVER_DB_PATH=./data/weaver.db

# Directory to ignore in addition to the scanner defaults (.git, node_modules, ...).
WEAVER_IGNORE_EXTRAS=node_modules,dist,coverage

# Default export formats used by `weaver show` when no format is given.
WEAVER_EXPORT_FORMAT=json

# Where exported graphs/insights are written.
WEAVER_EXPORT_DIR=./artifacts

# Serve the interactive browser viewer.
WEAVER_PORT=3000
WEAVER_HOST=127.0.0.1

# Fail (exit 0) on circular dependencies — use `weaver analyze --fail-on-cycle`.
WEAVER_FAIL_ON_CYCLE=

# Minimum edge weight for "hot path" insights (default 3).
WEAVER_HOT_PATH_MIN_WEIGHT=3

# Maximum reported cycles (default 20).
WEAVER_MAX_CYCLES=20

# Logging: "pretty" or "json".
WEAVER_LOG_PRETTY=1

# Plugin modules for the analyzer (comma separated).
# Example:
# WEAVER_PLUGINS=./plugins/my-plugin.ts
WEAVER_PLUGINS=
